      "acceptedAnswer": { "@type": "Answer", "text": "In most cases, no. We'll let you know in advance if any preparation is needed." }
    },
    {
      "@type": "Question", "name": "What pests do you handle?",
      "acceptedAnswer": { "@type": "Answer", "text": "We handle common household pests including ants, rodents, spiders, cockroaches, wasps, and more." }
    },
    {
      "@type": "Question", "name": "What if the pests come back?",
      "acceptedAnswer": { "@type": "Answer", "text": "If the issue returns, we'll follow up and make sure it's properly resolved." }
    },
    {
      "@type": "Question", "name": "Should I get a one-time treatment or ongoing protection?",
      "acceptedAnswer": { "@type": "Answer", "text": "If pests keep returning or you want long-term peace of mind, ongoing protection is the best option." }
    },
    {
      "@type": "Question", "name": "How much does pest control cost?",
      "acceptedAnswer": { "@type": "Answer", "text": "Pricing depends on the type of pest and level of treatment needed. We provide clear recommendations after inspection." }
    }
  ]
