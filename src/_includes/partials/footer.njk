{% from "partials/icons.njk" import icon %}
<footer class="site-footer">
  <div class="container footer-top">
    <div class="footer-grid">
      <div class="footer-col">
        <div class="footer-brand">
          <img src="/assets/images/logo-mark.svg" alt="" width="40" height="40">
          <strong>Zero Pest Control</strong>
        </div>
        <p>Licensed, insured pest control for homes and businesses across Sudbury and Northern Ontario. Fast response, clear pricing, and follow-up you can count on.</p>
        <ul class="footer-contact" style="margin-top:1.25rem;">
          <li>{{ icon("phone") }} <a href="tel:{{ site.phoneHref }}">{{ site.phone }}</a></li>
          <li>{{ icon("mail") }} <a href="mailto:{{ site.email }}">{{ site.email }}</a></li>
          <li>{{ icon("clock") }} <span>{{ site.hoursShort }}</span></li>
        </ul>
      </div>

      <div class="footer-col">
        <h3>Services</h3>
        <ul>
          {% for item in collections.services %}
          <li><a href="{{ item.url }}">{{ item.data.pestName or item.data.title }}</a></li>
          {% endfor %}
        </ul>
      </div>

      <div class="footer-col">
        <h3>Company</h3>
        <ul>
          <li><a href="/residential/">Residential</a></li>
          <li><a href="/commercial/">Commercial</a></li>
          <li><a href="/industries/">Industries We Serve</a></li>
          <li><a href="/pest-library/">Pest Library</a></li>
          <li><a href="/blog-resources/">Blog &amp; Resources</a></li>
          <li><a href="/faq/">FAQ</a></li>
          <li><a href="/contact/">Contact</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h3>Service Areas</h3>
        <ul>
          {% for area in site.areas %}
          <li><a href="/contact/?area={{ area.slug }}">{{ area.name }}</a></li>
          {% endfor %}
        </ul>
      </div>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container">
      <p>&copy; {% year %} Zero Pest Control. All rights reserved.</p>
      <div class="footer-legal">
        <a href="/privacy-policy/">Privacy Policy</a>
        <a href="/terms-of-service/">Terms of Service</a>
      </div>
    </div>
  </div>
</footer>
