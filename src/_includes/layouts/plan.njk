---
layout: layouts/base.njk
---
{% from "partials/icons.njk" import icon %}

<section class="hero hero--plan">
  <div class="container{% if heroImage %} hero-grid{% endif %}">
    <div class="reveal is-visible"{% if not heroImage %} style="max-width:760px;"{% endif %}>
      <div class="pill-row" style="margin-bottom:1.25rem;">
        {% for b in badges %}<span class="pill">{{ b }}</span>{% endfor %}
      </div>
      <h1>{{ h1 }}</h1>
      <p class="lede">{{ subtitle }}</p>
      <div class="hero-ctas">
        <a class="btn btn--primary" href="{{ primaryCtaHref or '/contact/' }}">{{ primaryCtaText or "Get a Free Quote" }}</a>
        <a class="btn btn--outline" href="tel:{{ site.phoneHref }}">{{ icon("phone") }} Call {{ site.phone }}</a>
      </div>
    </div>
    {% if heroImage %}
    {# Optional hero photo. Front matter: heroImage: { name, alt, width, height, focus, badge: { icon, title, text } }
       Expects src/assets/images/<name>-800.(webp|jpg) and <name>-1200.(webp|jpg). #}
    <div class="hero-visual reveal is-visible">
      <picture>
        <source type="image/webp" srcset="/assets/images/{{ heroImage.name }}-800.webp 800w, /assets/images/{{ heroImage.name }}-1200.webp 1200w" sizes="(max-width: 900px) 100vw, 560px">
        <img class="hero-photo" src="/assets/images/{{ heroImage.name }}-1200.jpg" srcset="/assets/images/{{ heroImage.name }}-800.jpg 800w, /assets/images/{{ heroImage.name }}-1200.jpg 1200w" sizes="(max-width: 900px) 100vw, 560px" alt="{{ heroImage.alt }}" width="{{ heroImage.width or 1200 }}" height="{{ heroImage.height or 800 }}" fetchpriority="high"{% if heroImage.focus %} style="object-position: {{ heroImage.focus }};"{% endif %}>
      </picture>
      {% if heroImage.badge %}
      <div class="visual-badge">
        <div class="icon-badge">{{ icon(heroImage.badge.icon) }}</div>
        <div>
          <strong>{{ heroImage.badge.title }}</strong>
          <span>{{ heroImage.badge.text }}</span>
        </div>
      </div>
      {% endif %}
    </div>
    {% endif %}
  </div>
</section>

<div class="trust-bar">
  <div class="container">
    {% for t in trustItems %}
    <div class="trust-bar-item">{{ icon(t.icon) }} {{ t.text }}</div>
    {% endfor %}
  </div>
</div>

<section class="section">
  <div class="container">
    <div class="path-panel reveal">
      <div class="path path--urgent">
        <div class="path-head">
          <div class="icon-badge">{{ icon(pathA.icon) }}</div>
          <span class="path-tag">{{ pathA.tag or "Urgent" }}</span>
        </div>
        <h3>{{ pathA.title }}</h3>
        <p>{{ pathA.text }}</p>
        <a class="btn btn--primary" href="{{ pathA.ctaHref }}">{{ icon("phone") }} {{ pathA.ctaText }}</a>
      </div>
      <div class="path path--planned">
        <span class="path-or" aria-hidden="true">or</span>
        <div class="path-head">
          <div class="icon-badge">{{ icon(pathB.icon) }}</div>
          <span class="path-tag">{{ pathB.tag or "Prevention" }}</span>
        </div>
        <h3>{{ pathB.title }}</h3>
        <p>{{ pathB.text }}</p>
        <a class="btn btn--outline" href="{{ pathB.ctaHref }}">{{ pathB.ctaText }} {{ icon("chevron-down") }}</a>
      </div>
    </div>
  </div>
</section>

<section class="section section--soft">
  <div class="container">
    <div class="grid grid--2">
      <div class="reveal">
        <h2 style="margin-bottom:1.25rem;">{{ problemList.heading }}</h2>
        <ul class="problem-list check-list">
          {% for item in problemList.items %}
          <li>{{ icon("x-circle") }} <span>{{ item }}</span></li>
          {% endfor %}
        </ul>
      </div>
      <div class="reveal">
        <h2 style="margin-bottom:1.25rem;">{{ solutionList.heading }}</h2>
        <ul class="check-list">
          {% for item in solutionList.items %}
          <li>{{ icon("check") }} <span>{{ item }}</span></li>
          {% endfor %}
        </ul>
      </div>
    </div>
  </div>
</section>

{% if featureCards and featureCards.length %}
<section class="section">
  <div class="container">
    <div class="grid grid--4">
      {% for f in featureCards %}
      <div class="card reveal">
        <div class="icon-badge icon-badge--sm">{{ icon(f.icon) }}</div>
        <h3 style="font-size:1.05rem;">{{ f.title }}</h3>
        <p>{{ f.text }}</p>
      </div>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

<section class="section section--soft">
  <div class="container">
    <div class="section-head center reveal">
      <p class="section-eyebrow" style="justify-content:center;">How It Works</p>
      <h2>{{ stepsHeading or "How We Protect You" }}</h2>
      <p>Fast response, clear steps, and guaranteed follow-ups for homes and businesses across Northern Ontario.</p>
    </div>
    <div class="steps">
      {% for s in steps %}
      <div class="step reveal">
        <div class="step-number">{{ loop.index }}</div>
        <h3>{{ s.title }}</h3>
        <p>{{ s.text }}</p>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="cta-banner reveal">
      <div>
        <h2>{{ closing.heading }}</h2>
        <p>{{ closing.text }}</p>
      </div>
      <div class="cta-banner-actions">
        <a class="btn btn--primary" href="/contact/">{{ closing.ctaText or "Get a Free Quote" }}</a>
        <a class="btn btn--outline-invert" href="tel:{{ site.phoneHref }}">{{ icon("phone") }} Call {{ site.phone }}</a>
      </div>
    </div>
  </div>
</section>
